# **********************************************************************
# base-config: 	cookie.CBSR.fkl_pp51.BASESw
# **********************************************************************
#
# *** CLIMATE **********************************************************
#
# SPECIFY WHETHER RADIATIVE FORCING IS DERIVED FROM ATMOSPHERIC CO2	
# NOTE: 'y' requires that CO2 is being calculated in the first place ...
#       'n' can be used for a configuration either with or without explicitly calculated atmopsheric CO2
# e.g., ea_36=y -> raditive forcing is set by the calculated value of atmopsheric CO2
ea_36=y
#
# *** BIOLOGICAL NEW PRODUCTION ****************************************
#
# SPECIFY THE BIOLOGICAL EXPORT SCHEME
# e.g., bg_par_bio_prodopt='1N1T_PO4MM' -> as used in Cao et al. [2009]
bg_par_bio_prodopt='1N1T_PO4MM'
# SPECIFY BIOLOGICAL EXPORT PARAMETERS
# maximum rate of conversion of dissolved PO4 into organic matter by phytoplankton (mol kg-1 yr-1)
bg_par_bio_k0_PO4=8.9876e-006
# [PO4] M-M half-sat value (mol kg-1)
bg_par_bio_c0_PO4=8.9369e-007
#
# *** EXPORT RATIOS ****************************************************
#
# SPECIFY BULK CARBON EXPORT (AND/OR REDFIELD) RATIOS
# production fraction of dissolved organic matter
bg_par_bio_red_DOMfrac=0.66
# set fixed CaCO3:POC export rain ratio
bg_opt_bio_CaCO3toPOCrainratio='FIXED'
# underlying export CaCO3 as a proportion of particulate organic matter (i.e., CaCO3/POC)
# NOTE: the current calibrated Eocene value is 0.200,
#       whereas the modern uniform equivalent is closer to 0.100
# adjust CaCO3:POC rain ratio to give approximately 0.12 PgC CaCO3 yr-1 burial
bg_par_bio_red_POC_CaCO3=0.165000
# remove organic matter associated (implicit nitrogen) alkalinity transformations
# => so we do not end up with spurious weathering ALK fluxes from kerogens (or spurious Corg burial related fluxes)
bg_par_bio_red_PON_ALK=0.0
#
# *** REMINERALIZATION *************************************************
#
# SPECIFY PARAMETERS CONTROLLIING WATER-COLUMN DECAY OF DISSOLVED ORGANIC MATTER (DOM)
# DOC lifetime (yrs)
bg_par_bio_remin_DOMlifetime=0.5
# SPECIFY PARAMETERS CONTROLLIING WATER-COLUMN DECAY OF PARTICULATE ORGANIC MATTER (POM)
# initial fractional abundance of POC component #2
bg_par_bio_remin_POC_frac2=0.0557
# depth of remineralization or particulate organic matter
bg_par_bio_remin_POC_eL1=589.9451
# remineralization length #2 for POC
bg_par_bio_remin_POC_eL2=1000000.0
# SPECIFY PARAMETERS CONTROLLIING WATER-COLUMN DECAY OF CaCO3
# initial fractional abundance of CaCO3 component #2
bg_par_bio_remin_CaCO3_frac2=0.45
# depth of remineralization or CaCO3
bg_par_bio_remin_CaCO3_eL1=1.8905e+003
# remineralization length #2 for CaCO3
bg_par_bio_remin_CaCO3_eL2=1000000.0
# set 'instantaneous' water column remineralziation
bg_par_bio_remin_sinkingrate_physical=9.9E9
bg_par_bio_remin_sinkingrate_reaction=125.0
# maximum time-scale to geochemical reaction completion (days)
bg_par_bio_geochem_tau=45.0
#
# *** SEDIMENTS - GENERAL **********************************************
#
# REDOX CONFIGURATION
# add redox-dependent SEDGEM remin
sg_ctrl_sed_conv_sed_ocn_old=.false.
# DETRITAL FLXUES
# generic paleo detrital flux (g cm-2 kyr-1)
# NOTE: set to zero when applying a dust field (unless an additional detrital flux is required)
# set mean modern non-carbonate ('detrital' flux) (g cm-2 kyr-1)
sg_par_sed_fdet=0.309
# enhancement of det flux to shelf cells
sg_par_sed_fdet_rshelf=1.0
# SEDCORES
# configure some sediment cores ... 
sg_par_sedcore_save_mask_name='fkl_pp51.sedcoremask.dsea_transect.txt'
# increase number of internal array sedcore layers (from 10 x run duration to 20x run duration (kyr))
sg_par_n_sedcore_tot_perky=20
#
# *** SEDIMENTS - DEEP-SEA *********************************************
#
# SEDIMENT TOPO
# max cut-off depth for neritic (non deep sea) sediment grid points
# NOTE: sediment grid points shallower that this and not defined as reefal cells, are assumed to be 'mud'
sg_par_sed_Dmax_neritic=175.0
# SEDIMENT DIAGENESIS
# specify carbonate diagenesis option
# NOTE: "ridgwell2001lookup" is the the simplest/fastest option
sg_par_sed_diagen_CaCO3opt="ridgwell2001lookup"
# bioturbation
# NOTE: turn OFF bioturbation to equilibriate the system faster
sg_ctrl_sed_bioturb=.FALSE.
#
# *** SEDIMENTS - MUDS *************************************************
#
# specify muds mask
sg_par_sed_muds_mask_name='fkl_pp51.mudsmask.BOTH.txt'
# add POC preservation and burial a-la Dunne et al. [2005]
sg_par_sed_diagen_Corgopt='dunne2007'
# scale POC burial
# NOTE: becasue the configuration includes a 'shelf', try no-scaling of POC preservation
sg_par_sed_diagen_fracCpres_scale=1.0
# add variable C:P remin a-la Wallmann [2010]
# NOTE: the default behaviour is for POP preservation to be in the same proportion as POC preservation and burial
sg_ctrl_sed_diagen_fracC2Ppres_wallmann2010=.true.
#
# *** SEDIMENTS - REEF *************************************************
#
# specify reef mask
sg_par_sed_reef_mask_name='fkl_pp51.reefmask.NONE.txt'
#
# *** WEATHERING *******************************************************
#
 # --- ROKGEM USER-CONFIG --------
 #
 # NOTE: automatically generated by SEDGEM
 # NOTE: this calculation assumes:
 #       silicate weathering fraction (sg_par_sed_diag_fracSiweath)     ==   0.40000000000000002     
 #       volcanic outgassing d13C (sg_par_sed_diag_volcanicd13C)        ==   -6.0000000000000000     
 #       implicit P:ALK in OM N transformation (sg_par_sed_diag_P2ALK)  ==    0.0000000000000000     
 #       adjust kerogen O2 consumption to balance global (Corg) O2 budget?  T
 #
 # turn off atmospheric short circuit
 rg_opt_short_circuit_atm=.false.
 # set CaCO3_weathering-temperature feedback
 rg_opt_weather_T_Ca=.true.
 # set CaSiO3_weathering-temperature feedback
 rg_opt_weather_T_Si=.true.
 # weathering reference mean global land air surface temperature (oC)
 # NOTE: this value can also be obtained from BIOGEM time-series: biogem_series_misc_SLT.res
 rg_par_ref_T0=   19.555109993779979     
 # global carbonate weathering rate (mol Ca2+ yr-1)
 rg_par_weather_CaCO3=   7336528910708.0703     
 #  global silicate weathering rate (mol Ca2+ yr-1)
 rg_par_weather_CaSiO3=   4891019273805.3809     
 # CO2 outgassing rate (mol C yr-1)
 rg_par_outgas_CO2=   6640872419265.4414     
 # set isotopic value of CO2 outgassing (set by: par_sed_diag_volcanicd13C) (o/oo)
 rg_par_outgas_CO2_d13C=  -6.0000000000000000     
 # set isotopic value of carbonate weathering (o/oo)
 rg_par_weather_CaCO3_d13C=   2.5275709681650951     
 # kerogen POC weathering ratio (to silicate Ca2+) and isotopic composiiton
 rg_par_weather_CaSiO3_fracC=   1.2284095888518736     
 rg_par_weather_CaSiO3_fracC_d13C=  -29.835436746363619     
 # kerogen POP weathering settings (as ratios with kerogen C)
 # NOTE: also account for implicitly associated ALK which is (sg_par_sed_diag_P2ALK):
 #       the PO4 flux *    0.0000000000000000     
 #       (but really ths should simply be zero when simulating geologic carbon cycling)
 rg_par_weather_kerogen_fracP=   2.1026665797104469E-002
 rg_par_weather_kerogen_fracALK=   0.0000000000000000     
 # updated kerogen O2 weathering consumption ratio to balance global (Corg) O2 budget
 rg_par_weather_kerogen_fracO2=  -1.6987455049025282     
 #
 # --- SEDGEM USER-CONFIG --------
 #
 # scale factor for reefal precipitation rate (mol cm-2 yr-1) to achieve a global burial rate of:    0.0000000000000000       (Tmol yr-1):
 sg_par_sed_reef_CaCO3precip_sf=   0.0000000000000000     
 #
 # --- BIOGEM USER-CONFIG --------
 #
 # set an OPEN system
 bg_ctrl_force_sed_closedsystem=.FALSE.
 # align marine organic matter P:ALK Redfield ratio with kerogen:
 bg_par_bio_red_PON_ALK=   0.0000000000000000     
 #
 # -------------------------------
#
# *** DATA SAVING ******************************************************
#
# SPECIFY WHAT TO SAVE!
# NOTE: (0) REFER TO THE COOKIE MANUAL FOR DETAILS!
#	(1) all 'false' will leave you with the basic (hidden option!) defaults: 
#           bg_ctrl_save_hidden_grid=.true., bg_ctrl_save_hidden_climate=.true.
#	(2) isotope output is enabled by turning on bg_ctrl_save_basic_proxies
#	(3) not selecting a biologicla scheme (or selection ECOGEM) will turn off bg_ctrl_save_basic_biologicalpump
#       (4) there are 4 'advanced' options corresponding to the 4 'basic' options which add more output
#	(5) turning off a 'basic' option will also turn off the corresponding advanced option
#	(6) bg_ctrl_save_basic_ALL=.true. turns on all basic options; 
#           bg_ctrl_save_advanced_ALL=.true. turns on all advanced options
bg_ctrl_save_basic_reservoirs=.TRUE.
bg_ctrl_save_basic_geochemistry=.TRUE.
bg_ctrl_save_basic_biologicalpump=.TRUE.
bg_ctrl_save_basic_proxies=.TRUE.
# SPECIFY THE INTERVAL AT WHICH TIME-SERIES DATA IS SAVED
# e.g., bg_par_data_save_sig_timeinterval=10.0 -> save time-series data every 10.0 years
# NOTE: to employ a file of save years in determining when time-series data is saved, set:
#       bg_par_data_save_sig_timeinterval=0.0 
bg_par_data_save_sig_timeinterval=10.0
# SPECIFY THE INTERVAL AT WHICH TIME-SLICE (SPATIAL) DATA IS SAVED
# e.g., bg_par_data_save_slice_timeinterval=1000.0 -> save time-slice data every 1000.0 years
# NOTE: in order to employ a file of save years to determine when time-slice data is saved, set:
#       bg_par_data_save_slice_timeinterval=0.0 
#       and then to save time-slice data only for the last year of the experiment, set: 
#       bg_par_infile_slice_name='save_timeslice_NONE.dat'
bg_par_data_save_slice_timeinterval=0.0
bg_par_infile_slice_name='save_timeslice_NONE.dat'
#
# *** FORCINGS *********************************************************
#
# specify forcings -- here: NO CARBON! @ -15 o/oo over 10 kyr
bg_par_forcing_name="pyyyyz.FpCO2_Fp13CO2"
bg_par_atm_force_scale_val_3=0.0
bg_par_atm_force_scale_val_4=-15.0
bg_par_atm_force_scale_time_3=10000.0
bg_par_atm_force_scale_time_4=10000.0
# add a geothermal heat flux (W m-2)
bg_par_Fgeothermal=100.0E-3
#
# *** INITIAL CONDITIONS ***********************************************
# 
#
# *** DIAGNOSTICS ******************************************************
#
# set Si weathering to be 1:1 with (Ca+Mg) silicate weathering to provide diagnostics
rg_par_weather_CaSiO3_fracSi=1.0
# remove Si from carb chem calc in case it accumulates unreasonably ...
gm_ctrl_carbchem_noH3SiO4=.true.
# weathering diagnostic settings
sg_par_sed_diag_fracSiweath=0.40000000000000002     
sg_par_sed_diag_volcanicd13C=-6.0000000000000000     
sg_par_sed_diag_P2ALK=0.0
sg_ctrl_sed_diag_balanceO2=.true.
#
# *** FEEDBACK CONFIGURATION *******************************************
#
#
# *** CARBCHEM SETTINGS ************************************************
#
# pH solution criteria (REVISED)
gm_ctrl_carbchem_pH_OLD=.FALSE.
# pH solution tolerance (pH units) (DEFAULT)
gm_par_carbchem_pH_tolerance=0.001
# pH solution tolerance for calculating buffering (DEFAULT)
gm_par_carbchem_pH_tolerance_buffering=0.0001
# factor relaxation in pH solution tolerance for re-try (DEFAULT)
gm_par_carbchem_dpH_tolerance=10.0
# pH solution maximum number of iterations (DEFAULT)
gm_par_carbchem_pH_iterationmax=10
# basic carb constant set (DEFAULT)
gm_par_carbconstset_name='Mehrbach'
# apply MYaim Mg/Ca correction -- Hain2015
gm_par_adj_carbconst_option='Hain2015'
# carbchem constant T and S range -- Hain2015
gm_par_carbchem_Tmin = -2.0
gm_par_carbchem_Tmax = 50.0
gm_par_carbchem_Smin = 30.0
gm_par_carbchem_Smax = 45.0
#
# *** MISC *************************************************************
#
# set NO seasonal cycle
ea_dosc=.false.
go_dosc=.false.
gs_dosc=.false.
#
# **********************************************************************
# *** END **************************************************************
# **********************************************************************
#
